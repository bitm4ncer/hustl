{
  "name": "hustl",
  "version": "1.0.0",
  "description": "Hustl – self-hosted Rechnungs- und Finanztool für Soloselbstständige",
  "main": "out/main/index.js",
  "author": "bitm4ncer",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitm4ncer/hustl.git"
  },
  "bugs": {
    "url": "https://github.com/bitm4ncer/hustl/issues"
  },
  "homepage": "https://github.com/bitm4ncer/hustl#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "icons": "node scripts/generate-icons.mjs && node scripts/generate-icns.mjs",
    "icons:icns": "node scripts/generate-icns.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build:web && npm run build:server",
    "dev:server": "tsx watch src/server/main.ts",
    "start:server": "node dist/server/index.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "keywords": [
    "invoicing",
    "finance",
    "self-hosted",
    "pwa",
    "electron",
    "german",
    "freelancer"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.64.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.15",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^7.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@node-rs/argon2": "^2.2.2",
    "@notionhq/client": "^5.22.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "archiver": "^8.0.0",
    "fastify": "^5.12.8",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "node-zugferd": "^0.1.1-beta.1",
    "nodemailer": "^7.0.13",
    "puppeteer-core": "^25.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.8.1",
    "unpdf": "^1.6.2",
    "zod": "^4.6.7"
  }
}
