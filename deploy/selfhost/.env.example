# Kopie nach /opt/hustl/.env — install.sh schreibt die Werte selbst.
# Diese Datei ist nur die Vorlage für eine manuelle Installation.

# Pflicht: Domain ohne https:// und ohne Slash. Muss per DNS auf den VPS zeigen.
HUSTL_DOMAIN=hustl.example.com
HUSTL_ORIGIN=https://hustl.example.com
HUSTL_RP_ID=hustl.example.com

# Pflicht für Let's Encrypt (Caddy).
ACME_EMAIL=du@example.com

# Europe/Berlin hält Nummernkreise und Monatsgrenzen in deutscher Zeit.
TZ=Europe/Berlin

# bundled = Caddy aus diesem Stack (80/443 müssen frei sein)
# external = bestehender Caddy/Nginx auf dem Host
HUSTL_PROXY=bundled

# Nur bei HUSTL_PROXY=external: Port, auf dem Hustl lokal lauscht.
HUSTL_PORT=3000

# Nur bei HUSTL_PROXY=external: Docker-Netz für einen Caddy-Container.
# Bei einem Host-Caddy/Nginx wird es nicht gebraucht.
PROXY_NETWORK=hustl-proxy

# Arbeitsspeicher-Limit des Containers.
HUSTL_MEM_LIMIT=1g
